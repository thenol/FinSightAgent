{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preliminary-assessment-output/1.0.0",
  "title": "Event Preliminary Assessment Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "thesis", "direction", "significance", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "summary": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "direction": {"enum": ["positive", "negative", "mixed", "neutral", "uncertain"]},
    "significance": {"enum": ["critical", "high", "medium", "low"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "event_characterization": {"type": "object"},
    "affected_scope": {"type": "array", "items": {"type": "object"}},
    "mechanism_hypotheses": {"type": "array", "items": {"type": "object"}},
    "scenario_outline": {"type": "array", "items": {"type": "object"}},
    "counter_hypotheses": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "watch_items": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}}
  }
}
