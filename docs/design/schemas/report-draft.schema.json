{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsight.local/schemas/report-draft/1.0.0",
  "title": "ReportDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "event_id", "as_of", "title", "summary", "claim_ids", "sections", "confidence", "disclaimer"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"enum": ["fact_card", "research_card"]},
    "event_id": {"type": "string", "pattern": "^evt_"},
    "as_of": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "signal": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "analysis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "items"],
        "properties": {
          "kind": {"enum": ["verified_facts", "impact", "counter_arguments", "conflicts", "unverified", "watch_items", "triggers", "limitations"]},
          "title": {"type": "string", "minLength": 1},
          "items": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
