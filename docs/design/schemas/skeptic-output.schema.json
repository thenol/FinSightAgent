{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finsight.local/schemas/skeptic-output/1.0.0",
  "title": "SkepticOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "counter_arguments",
    "fragile_assumptions",
    "thesis_breakers",
    "direction_assessment",
    "recommended_confidence",
    "review_required"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["complete", "partial", "insufficient_evidence"]},
    "counter_arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argument_id", "statement", "severity", "claim_ids", "targets"],
        "properties": {
          "argument_id": {"type": "string", "pattern": "^ctr_[a-zA-Z0-9_-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "targets": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "fragile_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "failure_mode", "materiality"],
        "properties": {
          "assumption_id": {"type": "string"},
          "failure_mode": {"type": "string", "minLength": 1},
          "materiality": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "thesis_breakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "indicator", "threshold", "horizon"],
        "properties": {
          "condition": {"type": "string", "minLength": 1},
          "indicator": {"type": "string", "minLength": 1},
          "threshold": {"type": "string", "minLength": 1},
          "horizon": {"type": "string", "minLength": 1}
        }
      }
    },
    "direction_assessment": {"enum": ["supports", "weakens", "reverses", "mixed", "inconclusive"]},
    "recommended_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_reasons": {"type": "array", "items": {"type": "string"}},
    "review_required": {"type": "boolean"},
    "review_reason": {"type": ["string", "null"]}
  }
}
