FINSIGHT_ENV=development
# memory: in-process (LLM configs still persist to .data/llm_config.json)
# postgresql: durable storage for all domains (recommended)
FINSIGHT_REPOSITORY=postgresql
FINSIGHT_DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight
# Host Redis for --dev uses 6380 to avoid clashing with other local Redis on 6379.
FINSIGHT_REDIS_URL=redis://localhost:6380/0
FINSIGHT_ARTIFACT_ROOT=.data/artifacts
# Generate a unique secret for every non-local deployment (>= 32 bytes).
FINSIGHT_JWT_SECRET=replace-with-a-random-32-byte-secret
# Dedicated Fernet key for encrypting LLM API keys (required in production).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FINSIGHT_SETTINGS_FERNET_KEY=
# Dev-only bootstrap credentials. Replace before production; never reuse in shared environments.
FINSIGHT_BOOTSTRAP_ADMIN_USERNAME=admin
FINSIGHT_BOOTSTRAP_ADMIN_PASSWORD=admin123
# Dev-only database password for local Compose. Override with a strong secret in production.
POSTGRES_PASSWORD=finsight
POSTGRES_USER=finsight
POSTGRES_DB=finsight
# Used by full Compose stack (in-network hostname "postgres")
FINSIGHT_COMPOSE_DATABASE_URL=postgresql+psycopg://finsight:finsight@postgres:5432/finsight
FINSIGHT_DEV_POSTGRES_PORT=5432
FINSIGHT_DEV_REDIS_PORT=6380
FINSIGHT_RSSHUB_BASE_URL=http://127.0.0.1:1200
FINSIGHT_DEFAULT_RATE_LIMIT_PER_MINUTE=10
FINSIGHT_FETCH_TIMEOUT_SECONDS=60
FINSIGHT_INGEST_MAX_ITEMS_PER_SYNC=20
FINSIGHT_ROBOTS_ENABLED=true
FINSIGHT_SOURCE_AUTO_DISABLE_FAILURES=5
MARKET_DATA_PROVIDER=bridge
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_BRIDGE_URL=http://127.0.0.1:8765
MARKET_ARCHIVE_ROOT=.data/market
MARKET_DATA_STORE=local
CLICKHOUSE_URL=clickhouse://localhost:8123/default
MINIO_ENDPOINT=http://localhost:9000
# market-data worker: comma-separated instrument ids, bar interval and cadence.
# Empty MARKET_DATA_INSTRUMENT_IDS means "all instruments in the master data catalog".
MARKET_DATA_INSTRUMENT_IDS=
MARKET_DATA_INTERVAL=1d
MARKET_DATA_LOOKBACK_DAYS=45
MARKET_DATA_WORKER_INTERVAL_SECONDS=300
# forecast-outcomes worker: settlement cadence and flat-direction band.
FORECAST_OUTCOME_WORKER_INTERVAL_SECONDS=3600
FORECAST_OUTCOME_FLAT_BAND=0.003
# Login brute-force protection (per client IP).
FINSIGHT_LOGIN_MAX_FAILURES=5
FINSIGHT_LOGIN_LOCKOUT_SECONDS=900
FINSIGHT_LOGIN_FAILURE_WINDOW_SECONDS=300
# Export Prometheus text metrics at GET /metrics when enabled.
FINSIGHT_METRICS_ENABLED=false
